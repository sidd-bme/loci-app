{
  "name": "loci-desktop",
  "productName": "Loci",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local biological image viewing, segmentation, and counting for research labs",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "npm@11.12.1",
  "overrides": {
    "@electron/packager": "18.4.4",
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "tmp": "0.2.7"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:mac": "electron-forge package --platform=darwin --arch=arm64",
    "package:mac:local": "node scripts/package-local.mjs",
    "package:windows:local": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform=darwin --arch=arm64",
    "make:mac:local": "LOCI_MAC_SIGN_MODE=adhoc-local electron-forge make --platform=darwin --arch=arm64",
    "make:windows:local": "electron-forge make --platform=win32 --arch=x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:packaged:mac": "node tests/packaged-app.qa.mjs",
    "qa:image-first-volume:mac": "node tests/image-first-volume.qa.mjs",
    "qa:image-first:windows": "node tests/windows-image-first.smoke.mjs",
    "qa:folder-import:mac": "node tests/folder-import.smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:packaging && npm run test",
    "test:packaging": "node --test scripts/package-local.node-test.mjs"
  },
  "dependencies": {
    "@kitware/vtk.js": "36.12.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/packager": "18.4.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.0.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "author": "Loci contributors"
}
