#!/bin/bash
#PBS -N loci-gpu-smoke
#PBS -q auto_free
#PBS -l select=1:ncpus=2:mem=8gb:ngpus=1
#PBS -l walltime=00:10:00
#PBS -j oe

set -euo pipefail
umask 027

: "${PBS_O_WORKDIR:?PBS must provide PBS_O_WORKDIR}"
: "${LOCI_PYTORCH_MODULE:?Set LOCI_PYTORCH_MODULE to the pinned Vanda PyTorch module name}"
: "${LOCI_MODEL_ENV:?Set LOCI_MODEL_ENV to the prepared loci-modeling virtual environment}"

unset PYTHONHOME PYTHONPATH
module purge
module load "${LOCI_PYTORCH_MODULE}"
source "${LOCI_MODEL_ENV}/bin/activate"
model_site="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
export PYTHONPATH="${model_site}${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONNOUSERSITE=1
cd "${PBS_O_WORKDIR}"

python - <<'PY'
import json
import platform
import sysconfig
import tempfile
from pathlib import Path

import numpy
import onnx
import onnxruntime
import scipy
import skimage
import tifffile
import torch
from google import protobuf
from PIL import __version__ as pillow_version

from loci_modeling.contracts import ModelConfig, PostprocessConfig
from loci_modeling.export import export_onnx
from loci_modeling.losses import LociInstanceLoss
from loci_modeling.model import LociResidualUNet
from loci_modeling.training import configure_reproducibility

environment_site = Path(sysconfig.get_paths()["purelib"])
if (environment_site / "torch").exists() or any(environment_site.glob("torch-*.dist-info")):
    raise RuntimeError(
        "LOCI_MODEL_ENV must not contain PyTorch; load torch==2.1.2 from the Vanda module"
    )
actual = torch.__version__.split("+", 1)[0]
if actual != "2.1.2":
    raise RuntimeError(f"Expected module-provided torch==2.1.2, received {torch.__version__}")
if platform.python_version() != "3.11.3":
    raise RuntimeError(f"Expected module Python 3.11.3, received {platform.python_version()}")
if torch.version.cuda != "12.1":
    raise RuntimeError(f"Expected PyTorch CUDA 12.1, received {torch.version.cuda}")
if torch.backends.cudnn.version() != 8902:
    raise RuntimeError(
        f"Expected cuDNN runtime 8.9.2, received {torch.backends.cudnn.version()}"
    )
if not torch.cuda.is_available():
    raise RuntimeError("PBS allocated a GPU but CUDA is unavailable to PyTorch")
expected_versions = {
    "numpy": (numpy.__version__, "1.26.4"),
    "onnx": (onnx.__version__, "1.22.0"),
    "onnxruntime": (onnxruntime.__version__, "1.29.0"),
    "pillow": (pillow_version, "10.0.0"),
    "protobuf": (protobuf.__version__, "7.36.0"),
    "scipy": (scipy.__version__, "1.11.1"),
    "scikit-image": (skimage.__version__, "0.24.0"),
    "tifffile": (tifffile.__version__, "2026.3.3"),
}
for dependency, (actual_version, expected_version) in expected_versions.items():
    if actual_version != expected_version:
        raise RuntimeError(
            f"Expected {dependency}=={expected_version}, received {actual_version}"
        )

configure_reproducibility(20260829)
device = torch.device("cuda")
model = LociResidualUNet(ModelConfig(base_channels=8, depth=2, dropout=0.0)).to(device)
loss_function = LociInstanceLoss().to(device)
optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)
images = torch.rand((2, 1, 64, 64), device=device)
targets = torch.zeros((2, 4, 64, 64), device=device)
targets[:, 0, 16:48, 16:48] = 1.0

optimizer.zero_grad(set_to_none=True)
prediction = model(images)
loss, _ = loss_function(prediction, targets)
loss.backward()
optimizer.step()
torch.cuda.synchronize()

with tempfile.TemporaryDirectory(prefix="loci-onnx-smoke-") as temporary_dir:
    export_onnx(
        model,
        Path(temporary_dir) / "probe.onnx",
        example_size=32,
        postprocess_config=PostprocessConfig(min_area_px=4, offset_scale_px=16.0),
        verify_runtime=True,
    )

print(
    json.dumps(
        {
            "status": "passed",
            "cuda": torch.version.cuda,
            "device": torch.cuda.get_device_name(0),
            "loss": float(loss.detach().cpu()),
            "onnx_probe": "passed",
            "torch": torch.__version__,
        },
        sort_keys=True,
    )
)
PY
